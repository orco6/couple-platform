// ═══════════════════════════════════════════════════════════════════════════
// BUSINESS DOMAIN MODELS — this business.
//
// Conventions (docs/adr/0004): Int agorot for money, @db.Date for business
// dates, explicit ownership columns with indexes, archivedAt/deletedAt instead
// of hard deletes, `version Int @default(1)` for concurrently edited records,
// onDelete: Restrict for anything historical.
//
// Every relation to User needs its back-relation in the marked block of
// core.prisma. Then: npm run db:migrate:dev -- --name <business>_domain
// ═══════════════════════════════════════════════════════════════════════════

/// A task on the couple's shared list — BUSINESS_RULES.md §3.
///
/// Both partners SEE and may act on every task (R-TASK-01): the list is shared,
/// and either of them can tick something off for the other. What `ownerId` adds
/// is *responsibility*, not permission — it names whose task this is, which is
/// what makes the rating meaningful: the partner who does NOT own a task is the
/// one who rates how it went (R-RATE-01).
///
/// Carries `version` because both partners edit the same list at the same time
/// on two phones.
model DailyTask {
  id String @id @default(cuid())

  title String

  /// The responsible partner. Required: an unowned task has nobody to rate.
  ownerId String
  owner   User   @relation("DailyTaskOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  /// The business day this task belongs to (R-TASK-01). Never createdAt.
  taskDate DateTime @db.Date

  /// Optional wall-clock hint ("עד 19:00"). Entered as date + time and
  /// converted on the server with localToInstant (ADR 0005), so the DST
  /// changes are handled in one place.
  dueTime DateTime?

  note String?

  /// Completion. Both columns move together or not at all (R-TASK-10).
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("DailyTaskCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("DailyTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// Archive, not delete (R-TASK-05): a task that stopped being relevant is a
  /// decision worth keeping, with its reason.
  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User?     @relation("DailyTaskArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  archiveReason String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating TaskRating?

  /// The list is read one day at a time, and the summaries read a date range;
  /// both want taskDate first. archivedAt is in the index because every
  /// working-list query excludes archived rows.
  @@index([taskDate, archivedAt])
  @@index([ownerId])
  /// The completion split in the summaries counts by who closed it.
  @@index([completedById])
  @@index([createdById])
}

/// How the other partner felt a completed task went — BUSINESS_RULES.md §3.
///
/// One rating per task (`taskId @unique`), given by the partner who does NOT
/// own it. That asymmetry is the point: rating your own work is a self-
/// assessment, and the product already has one of those in the daily entry.
/// This is the small, fast piece of feedback that would otherwise never be
/// said out loud.
///
/// Editable by its author — changing your mind about yesterday's dishes is
/// normal — but never deleted, because the averages in the summaries would
/// then move for no visible reason.
model TaskRating {
  id String @id @default(cuid())

  taskId String    @unique
  task   DailyTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  ratedById String
  ratedBy   User   @relation("TaskRatingRatedBy", fields: [ratedById], references: [id], onDelete: Restrict)

  /// 1–5. A choice, not a measurement.
  value Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ratedById])
}

/// One partner's closing of one day — BUSINESS_RULES.md §3.
///
/// A diary page: never archived, never soft-deleted, never hard-deleted (§28).
///
/// No `version` column, deliberately: only its author may write it (R-DAY-03),
/// so two people cannot edit one row and there is nothing to race.
///
/// Its value columns are the most sensitive data in the product. They are
/// readable by the other partner only once that partner has submitted their own
/// entry for the same date (R-DAY-05), which the service enforces by leaving
/// them out of the view entirely. They never enter an audit payload (R-DAY-30).
model DayEntry {
  id String @id @default(cuid())

  /// The business day being reviewed. Not the day it was submitted: a review
  /// at 00:20 can close the day that just ended (D-2).
  entryDate DateTime @db.Date

  partnerId String
  partner   User   @relation("DayEntryPartner", fields: [partnerId], references: [id], onDelete: Restrict)

  /// 1–5, mutual respect and the quality of communication that day. This is
  /// the ONLY daily rating: task execution is rated per task by the other
  /// partner (TaskRating), so a daily execution figure would be the same
  /// question asked twice with a worse denominator.
  respectRating Int

  note String?

  /// Server clock at submission. Used for ordering and "who closed first",
  /// never as a business date.
  submittedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One entry per partner per day, guaranteed by the database rather than by
  /// a service check (R-DAY-10). This unique index is also what the reveal
  /// lookup uses: "does the other partner have an entry for this date".
  @@unique([entryDate, partnerId])
  @@index([partnerId, entryDate])
}

/// The one partnership in this deployment — BUSINESS_RULES.md → D-1.
///
/// The brief asks for "two linked partners", and the link is explicit data
/// rather than something inferred from the user table. Inferring it (say, the
/// two oldest active users) breaks the moment a third account exists — a
/// fixture user, a spare account, an old one that was never disabled — and it
/// breaks *asymmetrically*: two people would disagree about who their partner
/// is, which in this product means the reveal rule pairs the wrong rows.
///
/// `id` is pinned to a single value by a CHECK constraint, so "one couple per
/// deployment" (ADR 0009) is a database guarantee and not a convention. If D-1
/// ever becomes "many couples", this table is already the row every scope
/// would filter by — which is the cheapest possible position to be in.
model Partnership {
  id String @id @default("couple")

  partnerAId String @unique
  partnerA   User   @relation("PartnershipPartnerA", fields: [partnerAId], references: [id], onDelete: Restrict)

  partnerBId String @unique
  partnerB   User   @relation("PartnershipPartnerB", fields: [partnerBId], references: [id], onDelete: Restrict)

  linkedById String
  linkedBy   User   @relation("PartnershipLinkedBy", fields: [linkedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
