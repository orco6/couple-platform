# ═══════════════════════════════════════════════════════════════════════════
# Environment variables. Copy to `.env` for local development.
#
# NAMES ONLY in this file — never real values. Production and preview values
# live in the hosting provider's encrypted environment settings (Vercel →
# Project → Settings → Environment Variables) and nowhere else.
#
# Every variable is validated at startup by src/core/env/env.ts. A missing or
# malformed required variable fails loudly instead of half-working.
# ═══════════════════════════════════════════════════════════════════════════

# ── Required ───────────────────────────────────────────────────────────────

# Which environment this process is. One of: development | test | preview | production
# On Vercel this is derived from VERCEL_ENV automatically when unset.
APP_ENV=development

# Runtime connection string.
#   local:      postgresql://bpf:bpf-local-only@127.0.0.1:5434/bpf_dev
#   Neon/Vercel: the POOLED connection string (host contains "-pooler"), with ?sslmode=require
DATABASE_URL=postgresql://bpf:bpf-local-only@127.0.0.1:5434/bpf_dev

# ── Required in preview and production ─────────────────────────────────────

# Public origin of the app, e.g. https://office.example.co.il
# Used for the same-origin (CSRF) check on every state-changing API request.
# APP_URL=

# ── Optional ───────────────────────────────────────────────────────────────

# Direct (non-pooled) connection used ONLY by Prisma migrations.
# Neon: the connection string WITHOUT "-pooler". Falls back to DATABASE_URL.
# DIRECT_URL=

# Force the session cookie Secure flag. Normally leave unset: it is derived from
# the request protocol (x-forwarded-proto), which is correct behind Vercel and
# correct on http://localhost.
# COOKIE_SECURE=

# Log level for the server logger: debug | info | warn | error (default info)
# LOG_LEVEL=

# ── Test / E2E only ────────────────────────────────────────────────────────

# Overrides for the suites. Each suite refuses any database whose name does not
# end in _test / _e2e respectively, and any non-local host.
# TEST_DATABASE_URL=postgresql://bpf:bpf-local-only@127.0.0.1:5434/bpf_test
# E2E_DATABASE_URL=postgresql://bpf:bpf-local-only@127.0.0.1:5434/bpf_e2e

# Enables the daily housekeeping endpoint (vercel.json cron). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=
