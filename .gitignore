# ── Dependencies and build output ────────────────────────────────────────────
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Generated Prisma client (regenerated by `npm install` / `npm run db:generate`)
/src/generated/

# ── Secrets ──────────────────────────────────────────────────────────────────
# Every .env variant is ignored. Only the example file, which holds names and
# never values, is tracked.
.env
.env.*
!.env.example
*.pem
*.key
.vercel

# Credentials printed by bootstrap/QA scripts, if anyone redirects them to disk.
*credentials*.txt

# ── Database dumps ───────────────────────────────────────────────────────────
# Not a blanket *.sql: prisma/migrations and scripts/sql are source code.
backups/
*.dump
*.sql.gz

# ── Test output ──────────────────────────────────────────────────────────────
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/coverage/
/screenshots/

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.log
npm-debug.log*
.tmp/
